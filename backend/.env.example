# MongoDB Connection URI
MONGO_URI=mongodb://localhost:27017/smartlibrary

# JWT Secret Key (required - server will refuse to start without it)
JWT_SECRET=your_jwt_secret_key_here

# Admin Internal Signup Secret Key
ADMIN_SECRET_KEY=your_admin_secret_key_here

# Backend Server Port (defaults to 5000)
PORT=5000

# Allowed Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Optional Google Books API Key (increases rate limits and prevents 429 quota errors)
# Leave empty to use unauthenticated requests with automatic Open Library fallback
GOOGLE_BOOKS_API_KEY=
